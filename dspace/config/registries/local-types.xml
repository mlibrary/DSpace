<?xml version="1.0" encoding="UTF-8"?>
        <!--
          - local-types.xml
          -
          - Registry for um-specific metadata.
          - Custom fields added to production d/b via the browser will
          - be populated by this file for new instances and migrations.
          -->
<dspace-dc-types>

<dspace-header>
    <title>Registry of UM-specific metadata fields</title>
    <contributor.author>DLA</contributor.author>
    <contributor.editor>migration</contributor.editor>
    <date.created>2026-10-16</date.created>
    <description>
        Local schema declaration plus dc.* qualifiers required by migrated content
        that are missing from a stock DSpace 7 instance.
    </description>
</dspace-header>

<!-- ================================================================ -->
<!-- 1. Local schema (institution-specific fields go here)             -->
<!-- ================================================================ -->

<dc-schema>
    <name>local</name>
    <namespace>http://dspace.org/namespace/local/</namespace>
</dc-schema>

<!-- ================================================================ -->
