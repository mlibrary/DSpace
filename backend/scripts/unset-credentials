#!/usr/bin/env bash

if [[ -n ${BASH_VERSION:-} && ${BASH_SOURCE[0]} == "$0" ]]; then
    printf 'Error: source this script to unset credentials in your current shell:\nsource backend/scripts/unset-credentials\n' >&2
    exit 1
fi

if [[ $# -eq 1 && ( $1 == --help || $1 == -h ) ]]; then
    printf 'Usage: source backend/scripts/unset-credentials\nRemove the credential files located through DSPACE_COOKIE_FILE and unset DSPACE_API_URL, DSPACE_TOKEN, DSPACE_XSRF_TOKEN, and DSPACE_COOKIE_FILE.\n'
    return 0
fi

_dspace_unset_credentials() (
    if [[ $# -ne 0 ]]; then
        printf 'Error: expected no arguments.\n' >&2
        return 1
    fi
    case "${DSPACE_COOKIE_FILE:-}" in
        /*/cookies.txt) ;;
        *)
            printf 'Error: DSPACE_COOKIE_FILE must be an absolute path to the generated cookies.txt.\n' >&2
            return 1
            ;;
    esac

    credentials_dir=${DSPACE_COOKIE_FILE%/*}
    if [[ -L $credentials_dir || ! -d $credentials_dir || ! -O $credentials_dir ]]; then
        printf 'Error: credential directory must exist, belong to you, and not be a symbolic link.\n' >&2
        return 1
    fi
    credentials_dir=$(cd -P -- "$credentials_dir" && pwd -P) || return 1
    case "${credentials_dir##*/}" in
        dspace-credentials.????????) ;;
        *)
            printf 'Error: refusing to remove files outside a generated dspace-credentials directory.\n' >&2
            return 1
            ;;
    esac
    for credential_file in "$credentials_dir/cookies.txt" "$credentials_dir/credentials.env"; do
        if [[ -L $credential_file || ( -e $credential_file && ! -f $credential_file ) ]]; then
            printf 'Error: expected a regular credential file: %s\n' "$credential_file" >&2
            return 1
        fi
    done
    rm -f -- "$credentials_dir/cookies.txt" "$credentials_dir/credentials.env" || return 1
    if ! rmdir -- "$credentials_dir"; then
        printf 'Error: could not remove credential directory; unrelated files were left untouched.\n' >&2
        return 1
    fi
    printf 'Removed credential files and directory: %s\n' "$credentials_dir"
)

if _dspace_unset_credentials "$@"; then
    unset -f _dspace_unset_credentials
    unset DSPACE_API_URL DSPACE_TOKEN DSPACE_XSRF_TOKEN DSPACE_COOKIE_FILE
    printf 'Unset DSPACE_API_URL, DSPACE_TOKEN, DSPACE_XSRF_TOKEN, and DSPACE_COOKIE_FILE.\n'
else
    unset -f _dspace_unset_credentials
    return 1
fi