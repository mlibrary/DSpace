#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: set-credentials DSPACE_API_URL

Prompt securely for an existing bearer token, obtain matching CSRF cookies,
and verify authentication. Requires curl and jq. Accepts tokens with or
without the "Bearer " prefix.

Example:
  ./backend/scripts/set-credentials https://your-backend.example.org/server/api

After success, run the printed source command in your current shell to set
DSPACE_API_URL, DSPACE_TOKEN, DSPACE_XSRF_TOKEN, and DSPACE_COOKIE_FILE for the bundle script.
Credentials are saved in a private temporary directory, not in the repository.
Remove that directory when finished. Do not source this script itself.
EOF
}

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

if [[ $# -eq 1 && ( $1 == --help || $1 == -h ) ]]; then
    usage
    exit 0
fi
[[ $# -eq 1 ]] || { usage >&2; exit 1; }
api_url=${1%/}
[[ $api_url =~ ^https://[^/?#[:space:]]+/server/api$ ]] \
    || die "Expected an HTTPS URL ending in /server/api."
for tool in curl jq; do
    command -v "$tool" >/dev/null 2>&1 || die "Required command not found: $tool"
done

printf 'Bearer token (input hidden): ' >&2
IFS= read -r -s token || die "Could not read the bearer token."
printf '\n' >&2
token=${token#Bearer }
[[ -n $token && $token != *[[:space:]]* ]] || die "Expected a nonempty bearer token without whitespace."

umask 077
credentials_dir=$(mktemp -d "${TMPDIR:-/tmp}/dspace-credentials.XXXXXXXX")
keep_credentials=false
cleanup() {
    rm -f "$credentials_dir/headers" "$credentials_dir/status.json" "$credentials_dir/authorization"
    if [[ $keep_credentials == false ]]; then
        rm -f "$credentials_dir/cookies.txt" "$credentials_dir/credentials.env"
        rmdir "$credentials_dir"
    fi
}
trap cleanup EXIT

cookie_file="$credentials_dir/cookies.txt"
printf 'Authorization: Bearer %s\n' "$token" > "$credentials_dir/authorization"
if ! status=$(curl --disable --silent --show-error \
    --connect-timeout 15 --max-time 60 \
    --header "@$credentials_dir/authorization" \
    --cookie-jar "$cookie_file" \
    --dump-header "$credentials_dir/headers" \
    --output "$credentials_dir/status.json" --write-out '%{http_code}' \
    "$api_url/authn/status"); then
    die "Authentication status request failed."
fi
[[ $status == 200 ]] || die "Authentication status returned HTTP $status."
jq -e '.authenticated == true' "$credentials_dir/status.json" >/dev/null \
    || die "The server did not confirm authentication. Obtain a fresh bearer token."

xsrf_token=$(awk '
    tolower($1) == "dspace-xsrf-token:" {
        sub(/^[^:]*:[ \t]*/, "")
        sub(/\r$/, "")
        token = $0
    }
    END { printf "%s", token }
' "$credentials_dir/headers")
[[ -n $xsrf_token && $xsrf_token != *[[:space:]]* ]] \
    || die "The server did not return a valid DSPACE-XSRF-TOKEN header."
awk -F '\t' -v token="$xsrf_token" '
    $6 == "DSPACE-XSRF-COOKIE" && $7 == token { found = 1 }
    END { exit !found }
' "$cookie_file" || die "The cookie jar does not contain the matching CSRF cookie."

{
    printf 'export DSPACE_API_URL=%q\n' "$api_url"
    printf 'export DSPACE_TOKEN=%q\n' "$token"
    printf 'export DSPACE_XSRF_TOKEN=%q\n' "$xsrf_token"
    printf 'export DSPACE_COOKIE_FILE=%q\n' "$cookie_file"
} > "$credentials_dir/credentials.env"
keep_credentials=true
printf 'Authentication verified. Run this command in your current shell:\n'
printf 'source %q\n' "$credentials_dir/credentials.env"
printf 'Remove the private credentials directory when finished: %s\n' "$credentials_dir"
